# Runtime
FRONTEND_ORIGIN=http://localhost:5173
PORT=5000
DATABASE_PATH=./predictions.db
API_TIMEOUT_SECONDS=8
TEAM_RATINGS_FILE=./ratings.json

# Live refresh
ENABLE_BACKGROUND_REFRESH=true
FIXTURE_REFRESH_SECONDS=300

# Frontend build-time setting
VITE_API_URL=

# ESPN fallback / fixtures
ESPN_SOCCER_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard
ESPN_BASKETBALL_SCOREBOARD_URL=https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard

# Structured injury provider (API-Football). Leave blank to use ESPN news fallback.
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_LEAGUE_ID=39
API_FOOTBALL_SEASON=2025

# Weather provider. Leave WEATHER_API_KEY blank to use Open-Meteo.
WEATHER_API_KEY=
WEATHER_API_URL=https://api.weatherapi.com/v1/current.json
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast
